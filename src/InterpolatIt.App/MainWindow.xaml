<Window x:Class="InterpolatIt.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Interpolate-it" Width="480" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Icon="Assets/Interpolate-it.ico">
    <StackPanel Margin="24,18,24,24">
        <DockPanel>
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="0,0,0,5">
                <Hyperlink Click="About_Click">About</Hyperlink>
            </TextBlock>
            <TextBlock Text="Interpolate-it" FontSize="24" FontWeight="SemiBold"/>
        </DockPanel>
        <TextBlock Text="Real-time AI frame interpolation for any window" Opacity="0.7" Margin="0,2,0,18"/>

        <TextBlock Text="Window" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="WindowList" DisplayMemberPath="Label" HorizontalAlignment="Stretch"
                      DropDownOpened="WindowList_DropDownOpened"/>
            <Button Grid.Column="1" Content="Refresh" Margin="8,0,0,0" Click="Refresh_Click"/>
        </Grid>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Frames" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="Factor2" Content="x2" GroupName="Factor" MinWidth="0" Margin="0,0,14,0" Checked="Option_Changed"/>
                    <RadioButton x:Name="Factor3" Content="x3" GroupName="Factor" MinWidth="0" Margin="0,0,14,0" Checked="Option_Changed"/>
                    <RadioButton x:Name="Factor4" Content="x4" GroupName="Factor" MinWidth="0" Margin="0,0,24,0" Checked="Option_Changed"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Quality" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="QualityList" HorizontalAlignment="Stretch" SelectionChanged="Option_Changed">
                    <ComboBoxItem Content="Quality  (RIFE 4.25)" Tag="rife-v4.25"/>
                    <ComboBoxItem Content="Fast  (RIFE 4.6)" Tag="rife-v4.6"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Button x:Name="StartButton" Content="Start Interpolating" Height="44" Margin="0,20,0,0" FontSize="15"
                HorizontalAlignment="Stretch" Style="{DynamicResource AccentButtonStyle}" Click="Start_Click"/>

        <CheckBox x:Name="EnabledSwitch" Margin="0,16,0,0" IsChecked="True"
                  Checked="EnabledSwitch_Changed" Unchecked="EnabledSwitch_Changed">
            <TextBlock><Run Text="Interpolation on"/><Run x:Name="EnabledHotkeyText" Text="   Ctrl+Alt+I" Foreground="Gray"/></TextBlock>
        </CheckBox>
        <CheckBox x:Name="FpsSwitch" Margin="0,4,0,0"
                  ToolTip="Top left in the target window: the frame rate detected in the source, the rate being aimed for and the rate actually shown"
                  Checked="FpsSwitch_Changed" Unchecked="FpsSwitch_Changed">
            <TextBlock><Run Text="Show detected, target and actual fps"/><Run x:Name="FpsHotkeyText" Text="   Ctrl+Alt+F" Foreground="Gray"/></TextBlock>
        </CheckBox>
        <CheckBox x:Name="EnhanceSwitch" Margin="0,4,0,0"
                  ToolTip="The graphics driver removes compression artifacts from every source frame before the in-between frames are made. This is NVIDIA's RTX Video Super Resolution: switch it on in the NVIDIA app under System > Video, where its quality is chosen as well."
                  Checked="EnhanceSwitch_Changed" Unchecked="EnhanceSwitch_Changed">
            <TextBlock><Run Text="Clean up compressed video"/><Run x:Name="EnhanceHotkeyText" Text="   Ctrl+Alt+H" Foreground="Gray"/></TextBlock>
        </CheckBox>
        <TextBlock x:Name="EnhanceText" Margin="28,2,0,0" Opacity="0.7" TextWrapping="Wrap" Visibility="Collapsed"/>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button x:Name="RecordButton" Content="Record" MinWidth="128" IsEnabled="False" Click="Record_Click"/>
            <TextBlock x:Name="RecordText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                       Opacity="0.7" Text="Ctrl+Alt+R  ·  MP4 of what the window shows, up to the display's frame rate"/>
        </Grid>

        <Border Margin="0,18,0,0" Padding="16,12,16,14" CornerRadius="8" BorderThickness="1" BorderBrush="#40808080">
            <StackPanel>
                <TextBlock x:Name="StateText" Text="Not running" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <UniformGrid Columns="3" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Source" Opacity="0.7"/>
                        <TextBlock x:Name="SourceFpsText" Text="–" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="fps" Opacity="0.7"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Target" Opacity="0.7"/>
                        <TextBlock x:Name="TargetFpsText" Text="–" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="fps" Opacity="0.7"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Actual" Opacity="0.7"/>
                        <TextBlock x:Name="ActualFpsText" Text="–" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="fps" Opacity="0.7"/>
                    </StackPanel>
                </UniformGrid>
                <TextBlock x:Name="DetailText" Opacity="0.7" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="HintText" Opacity="0.7" TextWrapping="Wrap" Margin="0,12,0,0"
                   Text="The picture runs a few hundredths of a second behind the real window; sound is not delayed."/>
    </StackPanel>
</Window>
